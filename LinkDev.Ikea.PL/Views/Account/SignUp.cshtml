@model SignUpViewModel

@{
    ViewData["Title"] = "SignUp";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
<div asp-validation-summary="All" class="text-danger"></div>
<div class="main-agileinfo">
	<div class="agileits-top">
		<form asp-action="SignUp">
			<div asp-validation-summary="ModelOnly"></div>
			<input class="text mb-2"  asp-for="FName" placeholder="Your First Name">
			<span asp-validation-for="FName" class="text-danger"></span>
			<br/>
			<input class="text mb-2" asp-for="LName" placeholder="Your Last Name">
			<span asp-validation-for="LName" class="text-danger"></span>
			<br/>
			<input class="text mb-2" asp-for="UserName" placeholder="Your UserName">
			<span asp-validation-for="UserName" class="text-danger"></span>
			<br />
			<input class="text email" asp-for="Email" placeholder="Your Email">
			<span asp-validation-for="Email" class="text-danger"></span>
			<br/>
			<input class="text" asp-for="Password" placeholder="Your Password">
			<span asp-validation-for="Password" class="text-danger"></span>
			<br/>
			<input class="text w3lpass" asp-for="ConfirmPassword" placeholder="Your Confirm Password">
			<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
			<br/>
			<div class="wthree-text">
				<label class="anim">
					<input  asp-for="IsAgree" class="checkbox" type="checkbox">
					<span>I Agree To The Terms & Conditions</span>
				</label>
				<div class="clear"> </div>
			</div>
			<input type="submit" value="SIGNUP">
		</form>
		<p>Do you have an Account? <a asp-action="SignIn"> Login Now!</a></p>
	</div>
</div>


@section ValidationScripts {
	<partial name="_ValidationScriptsPartial" />
}

