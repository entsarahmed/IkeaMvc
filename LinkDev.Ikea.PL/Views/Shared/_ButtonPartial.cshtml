@model string
<td>
    <a asp-action="Details" asp-route-id="@Model" class=" btn btn-warning">

        <i class="fas fa-eye me-2"></i>
    </a>
</td>
<td>
    <a asp-action="Edit" asp-route-id="@Model" class=" btn btn-success">
        <i class="fas fa-edit me-2"></i>
    </a>
</td>
<td>

    <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@Model"><i class="fas fa-trash me-2"></i></button>

</td>